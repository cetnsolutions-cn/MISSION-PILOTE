    const getToday = () => new Date().toISOString().split('T')[0];
    
    // Fonction pour obtenir la date par défaut (7 jours après aujourd'hui)
    const getDefaultStartDate = () => {
        const date = new Date();
        date.setDate(date.getDate() + 7);
        return date.toISOString().split('T')[0];
    };
    
    // Fonction pour obtenir le prochain jour ouvrable (lendemain, sauf si samedi/dimanche, alors lundi)
    const getNextBusinessDay = () => {
        const date = new Date();
        date.setDate(date.getDate() + 1); // Lendemain
        
        // Si c'est samedi (6) ou dimanche (0), passer au lundi
        while (date.getDay() === 0 || date.getDay() === 6) {
            date.setDate(date.getDate() + 1);
        }
        
        return date.toISOString().split('T')[0];
    };
    
    // Fonction pour formater un nombre avec des espaces (ex: 130000 -> "130 000")
    const formatNumberWithSpaces = (value) => {
        // Retirer tous les caractères non numériques
        const numbers = value.replace(/\D/g, '');
        // Ajouter des espaces tous les 3 chiffres depuis la fin
        return numbers.replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
    };

    const initialForm = {
        siret: '', companyName: '', address: '', 
        directorCivility: 'M.', directorFirstName: '', directorLastName: '', 
        clientEmail: '', clientPhone: '', vatNumber: '',
        targetAppointments: '', targetAppointmentsUnknown: false,
        salesRepsCount: 1, salesRepsCountUnknown: false,
        startDate: getDefaultStartDate(), endDate: '',
        radiusKm: '', radiusKmUnknown: false,
        minVehicleYear: '', minVehicleYearUnknown: false,
