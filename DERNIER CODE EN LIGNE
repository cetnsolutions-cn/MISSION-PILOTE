        // --- MOTEUR PDF ---
        const generateOrderPDF = (orderData, settings, returnUrl = false) => {
            const doc = new jsPDF();
            
            const colors = {
                darkBlue: [15, 23, 42],
                accent: [59, 130, 246],
                text: [51, 65, 85],
                lightBg: [248, 250, 252],
                white: [255, 255, 255]
            };

            const taxLabel = settings.enableVAT ? "TTC" : (settings.taxType || "HT");
            const vatPercentage = settings.vatPercentage || 20;

            doc.setFillColor(...colors.darkBlue);
            doc.rect(0, 0, 210, 50, 'F');

            if (settings.logo) {
                try {
                    doc.addImage(settings.logo, 'PNG', 15, 10, 40, 30, undefined, 'FAST');
                } catch(e) {}
            }

            doc.setFont("helvetica", "bold");
            doc.setFontSize(24);
            doc.setTextColor(...colors.white);
            doc.text("ORDRE DE MISSION PILOTE", 200, 25, { align: "right" });
            
            doc.setFontSize(10);
            doc.setFont("helvetica", "normal");
            doc.setTextColor(200, 200, 200);
            
            const refString = orderData.reference || "N/A";
            const dateToDisplay = orderData.createdAt && orderData.createdAt.seconds ? orderData.createdAt.seconds * 1000 : (orderData.createdAt || new Date());
            doc.text(`RÉF: ${refString}`, 200, 35, { align: "right" });
            doc.text(`Date: ${new Date(dateToDisplay).toLocaleDateString('fr-FR')}`, 200, 40, { align: "right" });

            doc.setFillColor(255, 255, 255);
            doc.roundedRect(145, 55, 55, 10, 1, 1, 'F');
            doc.setFontSize(9);
            doc.setFont("helvetica", "bold");
            doc.setTextColor(220, 38, 38);
            doc.text("SEMAINE PILOTE - SANS ENGAGEMENT", 172.5, 61, { align: "center" });

            let y = 75;
            doc.setFontSize(9);
            doc.setTextColor(...colors.text);
            doc.setFont("helvetica", "bold");
            doc.text("PRESTATAIRE", 15, y);
            doc.setFont("helvetica", "normal");
            doc.setTextColor(0);
            y += 5;
            doc.text(settings.myCompanyName || "Votre Société", 15, y);
            doc.text(settings.myAddress || "", 15, y+5);
            doc.text(settings.myEmail || "", 15, y+10);
            if(settings.myPhone) doc.text(`Tél: ${settings.myPhone}`, 15, y+15);
            if(settings.mySiret) doc.text(`SIRET: ${settings.mySiret}`, 15, y+20);
            if(settings.myVATNumber) doc.text(`TVA: ${settings.myVATNumber}`, 15, y+25);

            doc.setFont("helvetica", "bold");
            doc.setTextColor(...colors.darkBlue);
            doc.text("CLIENT", 115, 80);
            
            doc.setTextColor(0);
            doc.setFontSize(11);
            doc.text(orderData.companyName || "Nom Client", 115, 88);
            
            // Afficher le nom complet du signataire (civilité + prénom + nom)
            let ySignataire = 96;
            const directorCivility = orderData.directorCivility || '';
            const directorFirstName = orderData.directorFirstName || '';
            const directorLastName = orderData.directorLastName || '';
            if (directorCivility || directorFirstName || directorLastName) {
                const signataireName = `${directorCivility} ${directorFirstName} ${directorLastName}`.trim();
                if (signataireName) {
                    doc.setFont("helvetica", "normal");
                    doc.setFontSize(9);
                    doc.text(signataireName, 115, ySignataire);
                    ySignataire += 5;
                }
            }
            
            doc.setFont("helvetica", "normal");
            doc.setFontSize(9);
            
            const addressLines = doc.splitTextToSize(orderData.address || "Adresse", 85);
            doc.text(addressLines, 115, ySignataire);
            
            let yAfterAddress = ySignataire + (addressLines.length * 4);
            
            // Récupérer le SIREN/SIRET (peut être dans siren ou siret)
            const sirenSiret = orderData.siren || orderData.siret || '';
            const sirenDisplay = (sirenSiret === "EN COURS") ? "EN COURS D'IMMATRICULATION" : sirenSiret;
            
            // Déterminer si c'est un SIREN (9 chiffres) ou SIRET (14 chiffres)
            // Un SIRET fait 14 chiffres, un SIREN fait 9 chiffres
            let label = "SIREN";
            if (sirenDisplay && sirenDisplay !== "EN COURS D'IMMATRICULATION") {
                // Enlever les espaces et caractères non numériques pour vérifier
                const cleanNumber = sirenDisplay.toString().replace(/\s/g, '');
                if (cleanNumber.length === 14 && /^\d+$/.test(cleanNumber)) {
                    label = "SIRET";
                } else if (cleanNumber.length === 9 && /^\d+$/.test(cleanNumber)) {
                    label = "SIREN";
                } else {
                    // Si on ne peut pas déterminer, utiliser SIREN/SIRET
                    label = "SIREN/SIRET";
                }
            }
            
            if (sirenDisplay) {
                doc.text(`${label}: ${sirenDisplay}`, 115, yAfterAddress);
                yAfterAddress += 5;
            }
            
            // Afficher le téléphone du client s'il existe
            const clientPhone = orderData.clientPhone || orderData.phone || '';
            if (clientPhone) {
                doc.text(`Tél: ${clientPhone}`, 115, yAfterAddress);
                yAfterAddress += 5;
            }
            
            // Afficher le numéro de TVA du client s'il existe
            if(orderData.vatNumber) {
                doc.text(`TVA: ${orderData.vatNumber}`, 115, yAfterAddress);
                yAfterAddress += 5;
            }
            
            if(orderData.clientEmail) {
                doc.text(orderData.clientEmail, 115, yAfterAddress);
            }

            y = 130;
            doc.setFontSize(12);
            doc.setFont("helvetica", "bold");
            doc.setTextColor(...colors.darkBlue);
            doc.text("DÉTAILS DE LA MISSION", 15, y);

            y += 5;
            doc.setFillColor(...colors.darkBlue);
            doc.rect(15, y, 180, 10, 'F');
            doc.setTextColor(...colors.white);
            doc.setFontSize(9);
            doc.text("DESCRIPTION", 20, y+6.5);
            doc.text("DÉTAIL / VALEUR", 130, y+6.5);
            
            y += 10;

            const repCount = parseInt(orderData.salesRepsCount) || 1;
            const repLabel = repCount > 1 ? "Commerciaux" : "Commercial";

            // Fonction pour formater les nombres avec espaces (ex: 130000 -> 130 000)
            const formatNumberWithSpaces = (num) => {
                if (!num) return num;
                return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
            };

            // Formater le kilométrage max avec espaces
            const formattedMaxKm = formatNumberWithSpaces(orderData.maxKmPerVehicle);
            
            // Gérer les valeurs "Je ne sais pas"
            const targetAppointmentsDisplay = orderData.targetAppointmentsUnknown ? "Non renseigné" : (orderData.maxRdvTotal || '-');
            const radiusKmDisplay = orderData.radiusKmUnknown ? "Non renseigné" : orderData.radiusKm;
            const minVehicleYearDisplay = orderData.minVehicleYearUnknown ? "Non renseigné" : orderData.minVehicleYear;
            const maxKmDisplay = orderData.maxKmPerVehicleUnknown ? "Non renseigné" : formattedMaxKm;

            const rows = [
                ["Période d'essai", `Du ${new Date(orderData.startDate).toLocaleDateString('fr-FR')} au ${new Date(orderData.endDate).toLocaleDateString('fr-FR')} (7 jours)`],
                ["Type de mission", "Qualification de leads automobiles"],
                ["Nombre de Commerciaux", orderData.salesRepsCountUnknown ? "Informations Requise" : `${repCount} ${repLabel}`],
