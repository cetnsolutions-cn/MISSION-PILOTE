            setHasShownCivilityModal(false); // Réinitialiser quand on revient au formulaire
        }
    }, [step, hasShownCivilityModal]);

    // --- MOTEUR RECHERCHE ADRESSE (API GOUV) ---
    const handleAddressInput = async (e) => {
        const val = e.target.value;
        setForm(prev => ({ ...prev, address: val }));
        
        if (val.length > 3) {
            try {
                const res = await fetch(`https://api-adresse.data.gouv.fr/search/?q=${encodeURIComponent(val)}&limit=5`);
                const data = await res.json();
                if (data.features) {
                    setAddressSuggestions(data.features);
                    setShowSuggestions(true);
                }
            } catch (err) {
                console.log("Erreur adresse", err);
            }
        } else {
            setShowSuggestions(false);
        }
    };

    const selectAddress = (feature) => {
        setForm(prev => ({ ...prev, address: feature.properties.label }));
        setShowSuggestions(false);
    };

    // Formatage téléphone
    const handlePhoneChange = (e) => {
        const raw = e.target.value.replace(/[^\d]/g, '');
        let formatted = '';
        for (let i = 0; i < raw.length; i++) {
            if (i > 0 && i % 2 === 0) formatted += ' ';
            formatted += raw[i];
        }
        setForm(prev => ({ ...prev, clientPhone: formatted.substring(0, 14) }));
    };
    
    // Formatage rayon avec espaces
    const handleRadiusChange = (e) => {
        const formatted = formatNumberWithSpaces(e.target.value);
        setForm(prev => ({ ...prev, radiusKm: formatted }));
    };
    
    // Formatage kilométrage max avec espaces
    const handleMaxKmChange = (e) => {
        const formatted = formatNumberWithSpaces(e.target.value);
        setForm(prev => ({ ...prev, maxKmPerVehicle: formatted, maxKmPerVehicleUnknown: false }));
    };
    
    // Fonction pour définir la date de début au plus vite possible
    const setEarliestStartDate = () => {
        const nextBusinessDay = getNextBusinessDay();
        const nextDate = new Date(nextBusinessDay);
        const formattedDate = nextDate.toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long' });
        
        setForm(prev => ({ ...prev, startDate: nextBusinessDay }));
        setIsEarliestDate(true);
        setShowEarliestDateModal(true);
    };
    
    // Fonction pour ajouter un créneau d'appel technique
    const addTechnicalCallSlot = () => {
        setTechnicalCallSlots(prev => [...prev, { date: '', time: '' }]);
    };
    
    // Fonction pour supprimer un créneau d'appel technique
    const removeTechnicalCallSlot = (index) => {
        setTechnicalCallSlots(prev => prev.filter((_, i) => i !== index));
    };
    
    // Fonction pour mettre à jour un créneau d'appel technique
    const updateTechnicalCallSlot = (index, field, value) => {
        setTechnicalCallSlots(prev => prev.map((slot, i) => i === index ? { ...slot, [field]: value } : slot));
    };
    
    // Gestionnaire pour le champ heure avec passage automatique aux minutes
    const handleTimeInput = (e, index) => {
        const value = e.target.value;
        const input = e.target;
        
        // Mettre à jour la valeur
        updateTechnicalCallSlot(index, 'time', value);
    };
    
    // Fonction pour annuler et remettre la date par défaut
    const cancelEarliestDate = () => {
        setForm(prev => ({ ...prev, startDate: getDefaultStartDate() }));
        setIsEarliestDate(false);
    };

    const fetchCompanyData = async () => {
        if (form.siret.length < 9) return setError("SIRET invalide.");
        setLoading(true); setError(null);
        try {
            // 1. Vérifier d'abord dans Firestore si ce client existe déjà
            const siretToSearch = form.siret.replace(/\s/g, '');
            const qOrders = query(collection(db, "orders"), where("siren", "==", siretToSearch));
            const qContracts = query(collection(db, "contracts"), where("siren", "==", siretToSearch));
            const [ordersSnap, contractsSnap] = await Promise.all([getDocs(qOrders), getDocs(qContracts)]);
            
            let existingClientData = null;
            const allClientDocs = [...ordersSnap.docs, ...contractsSnap.docs];
            if (allClientDocs.length > 0) {
                // Prendre les données du document le plus récent
                const sortedDocs = allClientDocs.sort((a, b) => {
                    const aTime = a.data().createdAt?.seconds || 0;
                    const bTime = b.data().createdAt?.seconds || 0;
                    return bTime - aTime;
                });
                existingClientData = sortedDocs[0].data();
            }
            
            // 2. Récupérer les données de l'API gouvernementale
            const res = await fetch(`https://recherche-entreprises.api.gouv.fr/search?q=${form.siret}&page=1&per_page=1`);
            const data = await res.json();
            
            if (data.results?.[0]) {
                const r = data.results[0];
                const d = r.dirigeants?.[0];
                const detectedCivility = d ? (d.sexe === 'M' ? 'M.' : 'Mme') : 'M.';
                
                // --- AJOUT : Calcul automatique de la TVA ---
                let finalVAT = r.numero_tva_intracommunautaire || null;
                
                // Si l'API ne donne pas la TVA, on la calcule (FR + Clé + SIREN)
                if (!finalVAT && r.siren) {
                    try {
                        const sirenNum = parseInt(r.siren, 10);
                        const tvaKey = (12 + 3 * (sirenNum % 97)) % 97;
                        // Ajout du 0 si la clé est < 10
                        const keyStr = tvaKey < 10 ? `0${tvaKey}` : `${tvaKey}`;
                        finalVAT = `FR${keyStr}${r.siren}`;
                    } catch (e) {
                        console.error("Erreur calcul TVA", e);
                    }
                }
                // ---------------------------------------------

                // 3. Fusionner les données
                setForm(prev => ({
                    ...prev,
                    companyName: r.nom_complet || existingClientData?.companyName || prev.companyName,
                    address: r.siege?.adresse || existingClientData?.address || prev.address,
                    siret: r.siren,
                    directorFirstName: d ? d.prenoms.split(' ')[0] : (existingClientData?.directorFirstName || prev.directorFirstName),
                    directorLastName: d ? d.nom : (existingClientData?.directorLastName || prev.directorLastName),
                    directorCivility: detectedCivility || existingClientData?.directorCivility || prev.directorCivility,
                    
                    clientEmail: existingClientData?.clientEmail || prev.clientEmail,
                    clientPhone: existingClientData?.clientPhone || prev.clientPhone,
                    
                    // On utilise le calcul final ici
                    vatNumber: finalVAT || existingClientData?.vatNumber || prev.vatNumber
                }));
                
                // Afficher un message si on a trouvé un historique
                if (existingClientData) {
                    setError(null);
                    // Optionnel : afficher une notification discrète
                    setTimeout(() => {
                        // On pourrait afficher une petite notification ici
                    }, 100);
                }
            } else {
                // Si pas de résultat API mais qu'on a un historique, utiliser l'historique
                if (existingClientData) {
                    setForm(prev => ({
                        ...prev,
                        companyName: existingClientData.companyName || prev.companyName,
                        address: existingClientData.address || prev.address,
                        directorFirstName: existingClientData.directorFirstName || prev.directorFirstName,
                        directorLastName: existingClientData.directorLastName || prev.directorLastName,
                        directorCivility: existingClientData.directorCivility || prev.directorCivility,
                        clientEmail: existingClientData.clientEmail || prev.clientEmail,
                        clientPhone: existingClientData.clientPhone || prev.clientPhone,
                        vatNumber: existingClientData.vatNumber || prev.vatNumber || ''
                    }));
                } else {
                    setError("Aucune entreprise trouvée.");
                }
            }
        } catch (e) { 
            setError("Erreur API."); 
            console.error("Erreur fetchCompanyData:", e);
        }
        setLoading(false);
    };

    // Fonctions pour vérifier si chaque onglet est complet
    const isEntrepriseTabComplete = () => {
        // Le SIRET est valide s'il est rempli OU si "En cours" est coché
        const siretValid = form.siret || isSiretPending;
        return !!(form.companyName && form.address && siretValid);
    };
    
    const isSignataireTabComplete = () => {
        // Vérifier que le téléphone a exactement 10 chiffres
        const phoneDigits = form.clientPhone.replace(/[^\d]/g, '');
        const phoneValid = phoneDigits.length === 10;
        // Vérifier que l'email contient @
        const emailValid = form.clientEmail && form.clientEmail.includes('@');
        // Vérifier que le prénom est rempli (obligatoire)
        return !!(form.directorLastName && form.directorFirstName && emailValid && phoneValid);
    };
    
    const isMissionTabComplete = () => {
