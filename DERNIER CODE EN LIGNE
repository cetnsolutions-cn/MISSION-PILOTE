                maxKmPerVehicle: currentOrder.maxKmPerVehicle ? formatNumberWithSpaces(String(currentOrder.maxKmPerVehicle)) : '',
                salesRepsCount: currentOrder.salesRepsCount || 1,
                salesRepsCountUnknown: currentOrder.salesRepsCountUnknown || false
            });
