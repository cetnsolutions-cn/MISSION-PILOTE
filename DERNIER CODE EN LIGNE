            React.createElement('span', { className: "font-bold text-sm" }, statusMessage.text)
        ),
        showAddTypeModal && React.createElement('div', { className: "fixed inset-0 bg-black/60 backdrop-blur-sm z-[300] flex items-center justify-center p-4" },
            React.createElement('div', { className: "bg-white rounded-2xl p-6 w-full max-w-md shadow-2xl animate-in zoom-in-95" },
                React.createElement('h3', { className: "text-xl font-black text-slate-900 mb-4" }, "Ajouter un type de document"),
                React.createElement('label', { className: "block text-sm font-bold text-slate-600 mb-2" }, "Nom du nouveau type :"),
                React.createElement('input', { 
                    type: "text", 
                    value: newTypeName,
                    onChange: e => setNewTypeName(e.target.value),
                    onKeyDown: e => {
                        if (e.key === 'Enter') {
                            const currentTypes = globalSettings.documentTypes || ["Info", "Facture", "ASigner", "Demande", "Urgent"];
                            if (newTypeName.trim() && !currentTypes.includes(newTypeName.trim())) {
                                setGlobalSettings({...globalSettings, documentTypes: [...currentTypes, newTypeName.trim()]});
                                setStatusMessage({ type: 'success', text: "Type ajouté avec succès !" });
                                setTimeout(() => setStatusMessage(null), 3000);
                                setShowAddTypeModal(false);
                                setNewTypeName("");
                            } else if (newTypeName.trim() && currentTypes.includes(newTypeName.trim())) {
                                setStatusMessage({ type: 'error', text: "Ce type existe déjà." });
                                setTimeout(() => setStatusMessage(null), 4000);
                            }
                        }
                    },
                    placeholder: "Ex: Important, Urgent, etc.",
                    className: "w-full p-4 bg-slate-50 border-2 border-slate-200 rounded-xl text-sm font-bold text-slate-800 outline-none focus:ring-2 focus:ring-purple-500 focus:border-purple-500 mb-4",
                    autoFocus: true
                }),
                React.createElement('div', { className: "flex justify-end gap-3" },
                    React.createElement('button', { 
                        onClick: () => {
                            setShowAddTypeModal(false);
                            setNewTypeName("");
                        },
                        className: "px-6 py-3 bg-slate-100 text-slate-700 rounded-xl font-bold hover:bg-slate-200 transition"
                    }, "Annuler"),
                    React.createElement('button', { 
                        onClick: () => {
                            const currentTypes = globalSettings.documentTypes || ["Info", "Facture", "ASigner", "Demande", "Urgent"];
                            if (newTypeName.trim() && !currentTypes.includes(newTypeName.trim())) {
                                setGlobalSettings({...globalSettings, documentTypes: [...currentTypes, newTypeName.trim()]});
                                setStatusMessage({ type: 'success', text: "Type ajouté avec succès !" });
                                setTimeout(() => setStatusMessage(null), 3000);
                                setShowAddTypeModal(false);
                                setNewTypeName("");
                            } else if (newTypeName.trim() && currentTypes.includes(newTypeName.trim())) {
                                setStatusMessage({ type: 'error', text: "Ce type existe déjà." });
                                setTimeout(() => setStatusMessage(null), 4000);
                            }
                        },
                        disabled: !newTypeName.trim(),
                        className: `px-6 py-3 rounded-xl font-bold transition ${newTypeName.trim() ? 'bg-purple-600 text-white hover:bg-purple-700' : 'bg-slate-300 text-slate-500 cursor-not-allowed'}`
                    }, "Ajouter")
                )
            )
        )
    ); // Fin du Return
}
        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(React.createElement(App));
    </script>
</body>
</html>
