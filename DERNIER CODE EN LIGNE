            const [ordersSnap, contractsSnap] = await Promise.all([getDocs(ordersQuery), getDocs(contractsQuery)]);
            
            const batch = writeBatch(db);
            
            // Ajouter la note à tous les documents du client
            ordersSnap.docs.forEach(doc => {
                const currentNotes = doc.data().notes || [];
                batch.update(doc.ref, { notes: [...currentNotes, note] });
