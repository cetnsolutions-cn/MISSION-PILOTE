    const [editingModificationReason, setEditingModificationReason] = useState(null); // {itemId, itemType, currentReason}
    const [newModificationReason, setNewModificationReason] = useState('');

    // Fonction getStatusDesign spécifique pour ClientsCRMModule (l'admin doit voir ses propres demandes de modification)
    const getStatusDesignForCRM = (item) => {
        const status = item.status || 'Pending';
        
        // 1. Suppression demandée
        if (status === 'RequestDelete') {
            return { color: 'bg-red-100 text-red-800 border border-red-200', label: 'DEMANDE SUPPR.', icon: 'trash' };
        }
        
        // 2. Refusé / Annulé
        if (status === 'Declined') {
            return { color: 'bg-red-50 text-red-700 border border-red-200', label: 'REFUSÉ / ANNULÉ', icon: 'x-circle' };
        }
        
        // 3. Validé / Payé
        if (item.validatedAt || status === 'Signed') {
            return { color: 'bg-green-100 text-green-800 border border-green-200', label: 'SIGNÉ / PAYÉ', icon: 'dollar' };
        }
        
        // 4. Demande de modification (PRIORITÉ : l'admin doit voir ce statut même s'il a créé la demande)
        if (item.hasBeenModified && item.lastModifiedBy && !item.validatedAt) {
            return { color: 'bg-orange-50 text-orange-700 border border-orange-200', label: 'DEMANDE DE MODIFICATION ENVOYÉE', icon: 'alert-circle' };
        }
        
        // 5. Autres statuts standards
        const statusInfo = StatusMap[status] || { label: status, color: "bg-slate-100 text-slate-700", icon: "circle" };
        return {
            label: statusInfo.label,
            color: `bg-${statusInfo.color}-100 text-${statusInfo.color}-700 border border-${statusInfo.color}-200`,
            icon: statusInfo.icon || "circle"
        };
    };

    // Récupérer tous les clients uniques depuis orders et contracts
    useEffect(() => {
        const unsubscribeOrders = onSnapshot(collection(db, "orders"), (snap) => {
            const orders = snap.docs.map(d => ({ id: d.id, ...d.data(), type: 'Mission' }));
            const unsubscribeContracts = onSnapshot(collection(db, "contracts"), (contractSnap) => {
                const contracts = contractSnap.docs.map(d => ({ id: d.id, ...d.data(), type: 'Contrat' }));
                const allItems = [...orders, ...contracts];
                
                // MODIFICATION : Exclure seulement les items avec status 'RequestDelete' (corbeille), mais garder les 'Declined' (annulés)
                const filteredItems = allItems.filter(item => item.status !== 'RequestDelete');
                
                // Grouper par SIREN pour créer des clients uniques
                // MODIFICATION : Inclure tous les items, même ceux avec 'NO_SIREN' ou sans SIREN, pour voir tous les contrats annulés
                const clientsMap = new Map();
                filteredItems.forEach(item => {
                    const siren = item.siren || item.siret || 'NO_SIREN';
                    // MODIFICATION : Ne pas exclure les items avec NO_SIREN, ils doivent aussi apparaître
                    if (!clientsMap.has(siren)) {
                        clientsMap.set(siren, {
                            siren: siren,
                            companyName: item.companyName || 'Sans nom',
                            address: item.address || '',
                            directorCivility: item.directorCivility || '',
                            directorFirstName: item.directorFirstName || '',
                            directorLastName: item.directorLastName || '',
                            clientEmail: item.clientEmail || item.email || '',
                            clientPhone: item.clientPhone || item.phone || '',
                            vatNumber: item.vatNumber || '',
                            notes: [],
                            salesRepsCount: item.salesRepsCount || null,
                            salesRepsCountUnknown: item.salesRepsCountUnknown || false,
                            items: []
                        });
                    }
                    clientsMap.get(siren).items.push(item);
                    // Agréger toutes les notes de tous les documents
                    if (item.notes && Array.isArray(item.notes)) {
                        item.notes.forEach(note => {
                            clientsMap.get(siren).notes.push({...note, source: item.reference || item.id});
                        });
                    }
                });
                // Trier les notes par date pour chaque client
                clientsMap.forEach((client, siren) => {
                    client.notes.sort((a, b) => {
                        const dateA = a.createdAt?.seconds || (a.createdAt ? new Date(a.createdAt).getTime() / 1000 : 0) || 0;
                        const dateB = b.createdAt?.seconds || (b.createdAt ? new Date(b.createdAt).getTime() / 1000 : 0) || 0;
                        return dateB - dateA;
                    });
                });
                
                setClients(Array.from(clientsMap.values()));
                setLoading(false);
            });
            return () => unsubscribeContracts();
        });
        return () => unsubscribeOrders();
    }, [db]);

    // Filtrer les clients selon la recherche
