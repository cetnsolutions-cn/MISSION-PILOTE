// --- DASHBOARD LAYOUT (ULTIMATE V3 : ZERO SCROLLBAR & FULL DESIGN) ---
function DashboardLayout({ user, userData, globalSettings, db, isAdmin, setView, currentOrder, setCurrentOrder, allSalesReps }) {
    const [currentModule, setCurrentModule] = useState('generator');
    const [showSuccessModal, setShowSuccessModal] = useState(null);
    const [todoCount, setTodoCount] = useState(0);
    const [docCount, setDocCount] = useState(0);
    const [scriptCount, setScriptCount] = useState(0);
    const [declinedCount, setDeclinedCount] = useState(0); // Nombre de demandes refusées à rectifier
    const [calendarCount, setCalendarCount] = useState(0); // Nombre de créneaux à venir non contactés
    const [notifications, setNotifications] = useState([]);
    const [mobileMenuOpen, setMobileMenuOpen] = useState(false);
    const [endingMissions, setEndingMissions] = useState([]); // Missions qui se terminent bientôt
    const [showEndingMissionModal, setShowEndingMissionModal] = useState(null); // Modal pour afficher les détails

    // --- LOGIQUE (Inchangée) ---
    useEffect(() => {
        if (isAdmin) {
            const qOrders = query(collection(db, "orders"), where("status", "==", "Pending"));
            const qContracts = query(collection(db, "contracts"), where("status", "==", "ToDraft"));
            const qDelete = query(collection(db, "orders"), where("status", "==", "RequestDelete"));
            // Compter aussi les missions/contrats avec status 'Envoyé' et adminRead: false
            const qEnvoyedOrders = query(collection(db, "orders"), where("status", "==", "Envoyé"), where("adminRead", "==", false));
            const qEnvoyedContracts = query(collection(db, "contracts"), where("status", "==", "Envoyé"), where("adminRead", "==", false));

            const handleSnap = (snap, type) => {
                Promise.all([getDocs(qOrders), getDocs(qContracts), getDocs(qDelete), getDocs(qEnvoyedOrders), getDocs(qEnvoyedContracts)]).then(async ([snapO, snapC, snapD, snapEO, snapEC]) => {
                    // Compter aussi les contrats signés non vus
                    const qSignedOrders = query(collection(db, "orders"), where("signedContractUploaded", "==", true), where("signedContractViewedByAdmin", "==", false));
                    const qSignedContracts = query(collection(db, "contracts"), where("signedContractUploaded", "==", true), where("signedContractViewedByAdmin", "==", false));
                    const [signedOrdersSnap, signedContractsSnap] = await Promise.all([getDocs(qSignedOrders), getDocs(qSignedContracts)]);
                    const signedCount = signedOrdersSnap.size + signedContractsSnap.size;
                    const envoyedCount = snapEO.size + snapEC.size;
                    setTodoCount(snapO.size + snapC.size + snapD.size + signedCount + envoyedCount);
                });
                snap.docChanges().forEach((change) => {
                    if (change.type === "added") {
                        const data = change.doc.data();
                        const created = data.createdAt?.seconds ? data.createdAt.seconds * 1000 : Date.now();
                        if (Date.now() - created < 300000) {
                            setNotifications(prev => [...prev, { id: change.doc.id, msg: "Nouvelle activité détectée." }]);
                            setTimeout(() => setNotifications(prev => prev.filter(n => n.id !== change.doc.id)), 6000);
                        }
                    }
                });
            };
            const unsub1 = onSnapshot(qOrders, (s) => handleSnap(s, 'orders'));
            const unsub2 = onSnapshot(qContracts, (s) => handleSnap(s, 'contracts'));
            const unsub3 = onSnapshot(qDelete, (s) => handleSnap(s, 'delete'));
            const unsub4 = onSnapshot(qEnvoyedOrders, (s) => handleSnap(s, 'envoyedOrders'));
            const unsub5 = onSnapshot(qEnvoyedContracts, (s) => handleSnap(s, 'envoyedContracts'));
            const qDocsAdmin = query(collection(db, "documents"), where("isNew", "==", true), where("uploadedBy", "==", "User"));
            const unsubDocsAdmin = onSnapshot(qDocsAdmin, (snap) => setDocCount(snap.size));
            
            // Compter les demandes refusées pour l'admin (toutes les demandes refusées)
            const qDeclinedOrdersAdmin = query(collection(db, "orders"), where("status", "==", "Declined"));
            const qDeclinedContractsAdmin = query(collection(db, "contracts"), where("status", "==", "Declined"));
            const updateDeclinedCountAdmin = async () => {
                const [ordersSnap, contractsSnap] = await Promise.all([
                    getDocs(qDeclinedOrdersAdmin),
                    getDocs(qDeclinedContractsAdmin)
                ]);
                const ordersCount = ordersSnap.docs.filter(d => !d.data().declinedViewedBySalesRep).length;
                const contractsCount = contractsSnap.docs.filter(d => !d.data().declinedViewedBySalesRep).length;
                setDeclinedCount(ordersCount + contractsCount);
            };
            const unsubDeclinedOrdersAdmin = onSnapshot(qDeclinedOrdersAdmin, () => updateDeclinedCountAdmin());
            const unsubDeclinedContractsAdmin = onSnapshot(qDeclinedContractsAdmin, () => updateDeclinedCountAdmin());
            updateDeclinedCountAdmin();
            
            return () => { 
                unsub1(); 
                unsub2(); 
                unsub3(); 
                unsub4(); 
                unsub5(); 
                unsubDocsAdmin();
                unsubDeclinedOrdersAdmin();
                unsubDeclinedContractsAdmin();
